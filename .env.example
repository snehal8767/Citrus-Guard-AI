# ---- Backend configuration ----
# Copy this file to .env and adjust values. NEVER commit .env.

# Database (SQLite for local demo)
DATABASE_URL=sqlite:///./data/citrusguard.db

# Auth
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Uploads
MAX_UPLOAD_MB=10
UPLOAD_DIR=./data/uploads

# Demo mode: when true, the official orchard scan deterministically flags Zone B
DEMO_MODE=true

# Logging
LOG_LEVEL=INFO

# ---- CORS note ----
# CORS_ORIGINS must list every frontend origin that will call this API,
# comma-separated. For production add your deployed frontend URL, e.g.:
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ---- Frontend build variable (set in the Vercel/Netlify dashboard) ----
# Not read by the backend. When building the frontend for production, add an
# environment variable named VITE_API_URL whose value is this backend's origin
# (no trailing slash), e.g.:
# VITE_API_URL=https://your-backend.onrender.com
# Local dev: leave it unset — the Vite dev server proxies /api -> localhost:8000.
